{
  "name": "rep-counter",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22.2 <23"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "start": "concurrently --kill-others-on-fail --names server,web --prefix-colors blue,magenta \"npm run dev -w @rep-counter/server\" \"npm run dev -w @rep-counter/web\"",
    "pr-scope": "node scripts/pr-scope.js",
    "test": "node --test \"scripts/**/*.test.js\" && npm run test --workspaces --if-present",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm run deps",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p scripts && npm run typecheck --workspaces --if-present",
    "deps": "depcruise packages apps"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "concurrently": "^10.0.6",
    "dependency-cruiser": "^18.6.0",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.4"
  }
}
